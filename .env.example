# Supabase (required) - used by the browser to call the edge functions
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Museum API keys are NOT set here. They are Supabase secrets read by the edge
# functions, so they never reach the browser:
#
#   npx supabase secrets set SMITHSONIAN_API_KEY=...   # free: https://api.data.gov/signup/
#   npx supabase secrets set HARVARD_API_KEY=...       # free: https://harvardartmuseums.org/collections/api
#   npx supabase secrets set EUROPEANA_API_KEY=...     # free: https://pro.europeana.eu/page/get-api
#   npx supabase secrets set FIRECRAWL_API_KEY=...     # optional, for the Scrape page
#   npx supabase secrets set ALLOWED_ORIGINS=https://your-site.example   # optional CORS lock-down

# Only for scripts/ingest-artifacts.ts (never expose this one to the browser)
# SUPABASE_SERVICE_ROLE_KEY=
